{
  "manifest_version": 3,
  "name": "pdf_ve – PDF-Viewer und -Editor",
  "short_name": "pdf_ve",
  "version": "0.1.0",
  "description": "PDFs aus Google Drive anzeigen, bearbeiten und Formulare ausfüllen. Ablage in pdf_ve/In und pdf_ve/Out.",
  "key": "",
  "action": {
    "default_title": "pdf_ve",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "HIER_DIE_CLIENT_ID_EINTRAGEN.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
